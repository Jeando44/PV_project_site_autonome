# PV_project — gabarit de configuration. Copier en .env et renseigner les valeurs.
# Ne JAMAIS versionner le .env réel.
#
# SSO_JWT_SECRET   : IDENTIQUE à celle de Solakvan_V7 (signe les jetons SSO).
# FLASK_SECRET_KEY : PROPRE à cette application, différente de SSO_JWT_SECRET
#                    et différente de celle de Solakvan_V7 (signe les cookies).
# Génération : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# APP_NAME et REQUIRED_PERMISSION doivent correspondre à la ligne external_apps
# déclarée côté Solakvan_V7 (voir DEPLOIEMENT.md § 4).

FLASK_SECRET_KEY=

# --- SSO ---------------------------------------------------------------------
# Clé de signature des tokens SSO. IDENTIQUE dans toutes les applications de
# l'écosystème, et DIFFÉRENTE de chaque FLASK_SECRET_KEY : ainsi la compromission
# d'un outil satellite ne permet pas de forger des sessions sur Solakvan_V7.
SSO_JWT_SECRET=

# Revalidation du token auprès de Solakvan_V7 (propagation des révocations)
SSO_REVALIDATION_MINUTES=5
SSO_REVALIDATION_GRACE_MINUTES=15

# Origines autorisées à appeler cette application depuis un navigateur (CORS + anti-CSRF).
# MAIN_APP_URL est toujours autorisée ; ajouter ici les origines supplémentaires.
CORS_ALLOWED_ORIGINS=

# Le cookie de session exige HTTPS par défaut. À mettre à true UNIQUEMENT pour un
# développement local en HTTP — ne jamais poser cette variable en production.
SESSION_COOKIE_INSECURE=true


MAIN_APP_URL=http://127.0.0.1:5000

APP_NAME=site_autonome

REQUIRED_PERMISSION=site_autonome

# Autres clés external_apps de Solakvan qui ouvrent cette application (séparées par des virgules).
# PV_project : le bouton « Concevoir mon projet résidentiel » (clé concevoir_mon_projet_residentiel,
# url .../concevoir_mon_projet/residentiel/, permission concevoir_mon_projet).
SSO_AUDIENCES_SUPPLEMENTAIRES=

# Édition de l'application (cf. app/utils/parcours.py) : vide pour PV_project (parcours PRO et
# Résidentiel selon le chemin), site_autonome pour PV_project_site_autonome.
APPLICATION_EDITION=site_autonome

# Base de données PROPRE au site autonome (jamais celle de PV_project). Création du schéma :
# python -m flask preparer-base (comme au déploiement, cf. entrypoint.sh).
# DATABASE_URL=mysql+pymysql://utilisateur:mot_de_passe@hote:3306/site_autonome?charset=utf8mb4
#
# Production Cloud Run (comme Solakvan_Projet) : NE PAS définir DATABASE_URL (prioritaire), mais
# les 4 variables ci-dessous. DB_HOST = nom de connexion de l'instance « projet:region:instance »
# -> socket Unix /cloudsql/... (connexion Cloud SQL à ajouter au service). Une adresse IP dans
# DB_HOST passe en TCP (IP privée + VPC).
# DB_USER=
# DB_PASS=
# DB_NAME=
# DB_HOST=projet:region:instance

# En local, PV_project et cette application partagent l'hôte localhost : les cookies ne
# distinguent pas les ports, il faut donc un nom de cookie différent. En production (adresse
# propre au service), garder __session, seul cookie transmis par Firebase Hosting.
SESSION_COOKIE_NAME=__session_sa

# Durée de session (en heures)
SESSION_LIFETIME=8

# Port (optionnel, pour local)
PORT=5002
# reCAPTCHA
#cles du site
RECAPTCHA_PUBLIC_KEY=
#cles secret
# reCAPTCHA Enterprise : clé API Google Cloud limitée à « reCAPTCHA Enterprise API »
# (restriction d'application : Aucun). Serveur uniquement, secrète.
RECAPTCHA_API_KEY=
# Facultatif : projet (défaut cmp-2025), seuil de score (défaut 0.5), délai en secondes (défaut 5)
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SCORE_THRESHOLD=
RECAPTCHA_TIMEOUT=

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_RECIPIENT=


ADMIN_EMAIL=
# Environnement
FLASK_ENV=development

# Google Maps API Keys
# GOOGLE_MAP_KEY=votre_cle_google_maps
GOOGLE_MAP_KEY=
GOOGLE_MAP_KEY_SECONDARY=
# a utiliser pour la production
# DATABASE_URL=mysql+pymysql://nom_utilisater:mot_de_passe@mysql:3306/nom_database?charset=utf8mb4

# A utiliser dans un environnement de test 
TEST_DATABASE_URL=
